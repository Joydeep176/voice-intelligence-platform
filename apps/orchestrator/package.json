{
  "name": "@vip/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS standalone worker app that owns BullMQ consumers (ADR-0002). Phase 1: foundation check worker only; no agents or LangGraph.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js)",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env ./node_modules/jest/bin/jest.js --selectProjects integration --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@vip/contracts": "workspace:*",
    "bullmq": "~6.7.6",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@vip/config": "workspace:*",
    "eslint": "catalog:",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "catalog:"
  }
}
