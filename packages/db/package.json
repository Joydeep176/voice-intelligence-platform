{
  "name": "@vip/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema, migrations and connection helpers (ADR-0005, DATABASE_DESIGN).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run --project integration",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env dist/cli/migrate.js",
    "seed": "node --env-file-if-exists=../../.env dist/cli/seed.js"
  },
  "dependencies": {
    "@vip/contracts": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vip/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
