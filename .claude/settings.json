{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/secrets/**)",
      "Read(./**/credentials*.json)",
      "Read(./storage/**)",
      "Read(./.local-storage/**)",
      "Read(./data/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.*.local)",
      "Edit(./**/.env.development)",
      "Edit(./**/.env.test)",
      "Edit(./**/.env.staging)",
      "Edit(./**/.env.production)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Edit(./**/secrets/**)"
    ],
    "ask": [
      "Bash(git push:*)"
    ]
  }
}
