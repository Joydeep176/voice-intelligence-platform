{
  "name": "voice-intelligence-platform",
  "private": true,
  "description": "Multilingual (English / Hindi / Hinglish) AI Voice Intelligence Platform: pnpm + Turborepo monorepo (ADR-0005).",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker/compose.yaml --env-file .env up -d --wait postgres redis",
    "infra:down": "docker compose -f infra/docker/compose.yaml --env-file .env down",
    "db:generate": "pnpm --filter @vip/db run generate",
    "db:migrate": "pnpm --filter @vip/db run migrate",
    "db:seed": "pnpm --filter @vip/db run seed",
    "audio:sync": "uv sync --directory services/audio",
    "audio:dev": "uv run --directory services/audio audio-service",
    "audio:test": "uv run --directory services/audio pytest",
    "audio:lint": "uv run --directory services/audio ruff check . && uv run --directory services/audio ruff format --check . && uv run --directory services/audio mypy"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
