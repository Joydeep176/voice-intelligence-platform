# Copy to .env (git-ignored) and replace every "change-me" value. Never commit .env.
# Local development only: these are not production settings.

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=vip
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vip
POSTGRES_PORT=5432
DATABASE_URL=postgres://vip:change-me@127.0.0.1:5432/vip
# Disposable database for integration tests; its name must end in _test.
TEST_DATABASE_URL=postgres://vip:change-me@127.0.0.1:5432/vip_test

# --- Redis (BullMQ only) ---
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# --- API ---
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5173
# Authentication is not implemented (OD-08b, OD-27). "dev" treats every request as the
# local dev principal, a member of DEV_WORKSPACE_ID only. The API refuses to start with
# AUTH_MODE=dev when NODE_ENV=production.
AUTH_MODE=dev
DEV_WORKSPACE_ID=00000000-0000-4000-8000-000000000001

# --- Storage ---
STORAGE_DRIVER=local
# Relative paths resolve from the repository root. Git-ignored.
STORAGE_LOCAL_ROOT=.local-storage

# --- Upload limits: interim development defaults; real limits are OD-10 (Open) ---
UPLOAD_MAX_BYTES=2147483648
UPLOAD_PART_SIZE_BYTES=8388608
UPLOAD_SESSION_TTL_MINUTES=1440

# --- Playback (ADR-0033): signed local playback URLs ---
# Required, at least 32 characters, no fallback. Generate your own: openssl rand -base64 48
MEDIA_URL_SIGNING_SECRET=change-me-generate-with-openssl-rand-base64-48
MEDIA_URL_TTL_SECONDS=300

# --- Audio service (internal; bearer-token auth, ADR-0035) ---
# AUDIO_SERVICE_TOKEN: shared secret between the API/orchestrator and the audio service. At least
# 32 characters, no default. Generate your own, e.g. `openssl rand -base64 48`; never commit it.
# The audio service refuses to start without it; the API starts without it but reports the audio
# service as "not configured".
AUDIO_SERVICE_TOKEN=
# Optional audio-service settings (defaults in services/audio/src/audio_service/config.py):
# AUDIO_SERVICE_STORAGE_ROOT (same directory as STORAGE_LOCAL_ROOT; /storage in the container),
# AUDIO_SERVICE_MAX_CONCURRENT_TASKS=1, AUDIO_SERVICE_MAX_QUEUED_TASKS=4,
# AUDIO_SERVICE_LANDLOCK=auto|required|off
AUDIO_SERVICE_URL=http://127.0.0.1:8001
AUDIO_SERVICE_TIMEOUT_MS=3000
AUDIO_SERVICE_PORT=8001

# --- Queues (ADR-0010 bounds) ---
QUEUE_FOUNDATION_CONCURRENCY=2
QUEUE_FOUNDATION_ATTEMPTS=3
QUEUE_FOUNDATION_BACKOFF_MS=1000
# Audio processing (Phase 2B; interim development defaults, OD-10 Open). Names only, values optional:
# PROCESSING_MAX_RETRIES=3, PROCESSING_POLL_INTERVAL_MS=2000, PROCESSING_RETRY_BACKOFF_MS=5000,
# PROCESSING_TASK_TIMEOUT_MS=900000, PROCESSING_SWEEP_INTERVAL_MS=60000, PROCESSING_SWEEP_BATCH=50,
# QUEUE_AUDIO_CONCURRENCY=1, QUEUE_AUDIO_ATTEMPTS=5, QUEUE_AUDIO_BACKOFF_MS=5000
# PROCESSING_TASK_TIMEOUT_MS is the sweeper staleness base only (not a task deadline).
# Node backstop deadline (interim, OD-10 / D-2B-20): PROCESSING_TASK_DEADLINE_BASE_MS=120000,
# PROCESSING_TASK_DEADLINE_GRACE_MS=60000; counted from the first `running` observation.
# Audio service (interim): AUDIO_SERVICE_TASK_DEADLINE_BASE_MS=120000,
# AUDIO_SERVICE_TASK_DEADLINE_PER_AUDIO_MS_PERMILLE=500
# Self-hosted inference in the audio service (ADR-0036 / ADR-0037). Models: `pnpm audio:models`
# installs the pinned files into .local-models; Compose copies them into the `audio-models` volume,
# mounted read-only at /models (Landlock cannot confine Docker Desktop host bind mounts):
# AUDIO_MODELS_HOST_ROOT (Compose, default ../../.local-models), AUDIO_SERVICE_MODELS_DIR (unset: no
# transcribe/diarize tasks), AUDIO_SERVICE_INFERENCE_THREADS=1,
# AUDIO_SERVICE_INFERENCE_DEADLINE_PER_AUDIO_MS_PERMILLE=4000, AUDIO_SERVICE_STT_SILENCE_DBFS=-50

# Transcription runs (Phase 2C; interim development defaults, OD-10 Open). Names only, values optional:
# STT_PROVIDER=fake|whisper-cpp, DIARIZATION_PROVIDER=fake|sherpa-onnx (adapter keys: `fake` for
# development and tests; `whisper-cpp` (ADR-0036) and `sherpa-onnx` (ADR-0037) run in the audio service
# and need AUDIO_SERVICE_TOKEN; an unknown key stops the orchestrator's run workers at startup),
# DIARIZATION_CLUSTER_THRESHOLD=0.6, DIARIZATION_MIN_ON_MS=300, DIARIZATION_MIN_OFF_MS=500,
# DIARIZATION_WHOLE_FILE_MAX_MS=600000, DIARIZATION_WINDOW_MS=600000, DIARIZATION_OVERLAP_MS=30000,
# DIARIZATION_MATCH_THRESHOLD=0.5, PROVIDER_POLL_INTERVAL_MS=1000,
# RUN_MAX_RETRIES=3 (re-executions of one run: user retries + sweeper recoveries; also read by the API),
# RUN_DEADLINE_MS=3600000, RUN_DEADLINE_PER_AUDIO_PERMILLE=6000, RUN_PROVIDER_TIMEOUT_MS=120000,
# RUN_PROVIDER_TIMEOUT_PER_AUDIO_PERMILLE=5000, RUN_STUCK_AFTER_MS=600000,
# RUN_SWEEP_INTERVAL_MS=60000, QUEUE_RUN_CONCURRENCY=1, QUEUE_RUN_ATTEMPTS=3, QUEUE_RUN_BACKOFF_MS=5000
# The orchestrator also reads STORAGE_LOCAL_ROOT (raw provider output under runs/<ws>/<run>/).

# --- Web (Vite exposes only VITE_* variables to the browser) ---
VITE_DEV_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
